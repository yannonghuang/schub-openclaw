# .env.example — Production environment template
# Copy to .env.prod and fill in all values before deploying.

# ── Server ────────────────────────────────────────────────────────────────────
# Full URL of the server as seen by browsers (no trailing slash)
FRONTEND_URL=https://192.168.x.x

# Path on the VM where allocator CSV files are stored
ALLOCATOR_CSV_PATH=/opt/allocator-csv

# ── Image registry ────────────────────────────────────────────────────────────
# Registry prefix with trailing slash, e.g. "ghcr.io/yourorg/" or "192.168.x.x:5000/"
REGISTRY=
TAG=latest

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate OPENCLAW_TOKEN with: openssl rand -hex 24
OPENCLAW_TOKEN=
POSTGRES_PASSWORD=postgres
PGADMIN_PASSWORD=securepassword

# ── AI ────────────────────────────────────────────────────────────────────────
# Allocator LLM provider:
#   nanogpt   (default) — call NanoGPT's OpenAI-compatible endpoint with
#                         NANOGPT_API_KEY. Reliable for short structured
#                         prompts (assessment RATING, planning copilot) and
#                         keeps allocator LLM cost off the direct OpenAI bill.
#                         Default model: minimax/minimax-m2.7.
#                         NOTE: AssessmentRoutes + PlanningCopilotRoutes pin
#                         to "nanogpt" via ASSESSMENT_PROVIDER regardless of
#                         this setting — see comments in those files.
#   openclaw            — route through the OpenClaw gateway, reusing its
#                         provider/credentials. No extra API key needed
#                         beyond OPENCLAW_TOKEN. Works with Claude Pro
#                         OAuth tokens (sk-ant-oat01-*).
#   anthropic           — call api.anthropic.com directly (requires a real
#                         sk-ant-api03-* API key in ANTHROPIC_API_KEY below).
#   openai              — call api.openai.com directly (requires OPENAI_API_KEY).
#   dashscope           — call Alibaba Cloud DashScope's OpenAI-compatible endpoint
#                         (requires DASHSCOPE_API_KEY; Qwen models).
# (OpenClaw gateway itself always uses ANTHROPIC_API_KEY regardless of this setting.)
LLM_PROVIDER=nanogpt
# Required by OpenClaw (always). Also used by the allocator when LLM_PROVIDER=anthropic.
# Accepts either a real API key (sk-ant-api03-*) or a Claude Pro OAuth token (sk-ant-oat01-*).
ANTHROPIC_API_KEY=
# Required by the allocator's assessment + planning-copilot LLM calls (they
# pin to nanogpt). Also used when LLM_PROVIDER=nanogpt.
NANOGPT_API_KEY=
# Override the NanoGPT base URL if needed (default: https://nano-gpt.com/api/v1).
# NANOGPT_BASE_URL=
# Optional. Only needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# DashScope (Qwen). Get an API key from the Alibaba Cloud DashScope/Bailian console.
DASHSCOPE_API_KEY=
# Default: https://dashscope.aliyuncs.com/compatible-mode/v1 (shared public endpoint).
# Override for a dedicated/reserved-capacity MaaS deployment, e.g.:
# DASHSCOPE_BASE_URL=https://<workspace-id>.<region>.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# ALLOCATOR_LLM_PROVIDER pins the allocator's own LLM calls (assessment,
# planning copilot, planning agent) independent of LLM_PROVIDER above — see
# Config.kt's doc comment. Default: nanogpt.
ALLOCATOR_LLM_PROVIDER=
# Overrides the default model id for whichever provider is active — e.g. set
# to your DashScope deployment's exact model id when ALLOCATOR_LLM_PROVIDER=dashscope.
ASSESSMENT_MODEL=

# ── Email (outbound SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Email (inbound IMAP — for HITL email replies) ─────────────────────────────
IMAP_HOST=imap.yourprovider.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Optional integrations ─────────────────────────────────────────────────────
MCP_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
ADAPTOR_POLL_INTERVAL=30
